# Copie para .env e preencha. O modo demo e os testes não precisam de nada daqui.

# Banco (SQL Server)
DB_SERVER=localhost
DB_NAME=IDENTIDADES
# Banco onde ficam as credenciais criptografadas da API do AD
DB_NAME_CREDENCIAIS=SEGURANCA
DB_USER=usuario_app
DB_PASSWORD=troque-esta-senha
DB_DRIVER=ODBC Driver 17 for SQL Server

# Active Directory (leitura via LDAP)
AD_SERVER=ldap://dc01.empresa.local
AD_USER=EMPRESA\svc_identidades
AD_PASS=troque-esta-senha
AD_BASE_DN=DC=empresa,DC=local
AD_PASTA_DESLIGADOS=ou=Desligados,ou=Usuarios,DC=empresa,DC=local

# API interna que executa as escritas no AD (criar, mover, renomear, desativar)
AD_API_URL=http://api-ad.empresa.local
AD_API_ID_CREDENCIAL=1

# E-mail do relatório de criação (opcional)
ENVIAR_RELATORIO_CRIACAO=false
EMAIL_USER=robo@example.com
EMAIL_PASS=troque-esta-senha
EMAIL_DEST=ti@example.com
EMAIL_CC=
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# Execução segura: true calcula e loga as ações, mas não altera banco/API/AD.
DRY_RUN=true
DRY_RUN_EXECUTE_PROCS=true

# CPFs (separados por vírgula) que a sincronização nunca mexe: diretoria, contas especiais
CPFS_IGNORAR_SINCRONIA=

# Rotina manual CPF/description: true corrige NM_LOGIN na tabela quando o nome no AD tiver match único.
CPF_DESCRICAO_CORRIGIR_LOGIN=false

# Pasta de logs (padrão: ./logs)
LOG_DIR=
